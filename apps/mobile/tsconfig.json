{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "app",
    "src",
    "app.config.ts"
  ],
  "exclude": [
    "node_modules",
    "ios",
    "android"
  ]
}
